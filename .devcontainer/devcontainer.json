{
  "name": "capstone",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:5-24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 4
  },
  "forwardPorts": [3000, 9000],
  "portsAttributes": {
    "3000": { "label": "Storefront" },
    "9000": { "label": "Medusa" },
    "5432": { "label": "Postgres", "onAutoForward": "ignore" },
    "6379": { "label": "Redis", "onAutoForward": "ignore" }
  },
  "postCreateCommand": "npm ci --prefix backend && npm ci --prefix storefront && ([ -f backend/.env.test ] || grep -E '^(DB_|REDIS_URL)' backend/.env.example > backend/.env.test)",
  "postStartCommand": "docker compose up -d"
}
