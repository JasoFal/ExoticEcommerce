{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "description": "Medusa commerce backend for the reptile store.",
  "license": "MIT",
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "db:reset": "docker compose exec -T postgres dropdb -U medusa --if-exists --force medusa_dev && docker compose exec -T postgres createdb -U medusa medusa_dev && medusa db:migrate && npm run seed",
    "test": "npm run test:unit",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.22.1",
    "@medusajs/cli": "2.22.1",
    "@medusajs/framework": "2.22.1",
    "@medusajs/medusa": "2.22.1"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.1",
    "@medusajs/test-utils": "2.22.1",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^8.3.5",
    "yalc": "^1.0.0-pre.53"
  },
  "overrides": {
    "zod": "4.6.6",
    "lodash": "4.18.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
