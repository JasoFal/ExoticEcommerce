# Copy to backend/.env for local development. Never commit .env.
# These are fake dev values. See docs/local-infrastructure.md section 6.

# Must match the Compose values in the root .env.example.
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa_dev
REDIS_URL=redis://localhost:6379

JWT_SECRET=dev-only-jwt-secret-change-me
COOKIE_SECRET=dev-only-cookie-secret-change-me

# In a Codespace, add the forwarded port-9000 URL
# (https://<codespace-name>-9000.app.github.dev) to ADMIN_CORS and AUTH_CORS.
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# Read by medusaIntegrationTestRunner (@medusajs/test-utils). It creates and
# drops its own temporary databases, so never point these at medusa_dev data.
# Put them in backend/.env.test (loaded by jest.config.js) or the shell env.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=medusa
DB_PASSWORD=medusa
