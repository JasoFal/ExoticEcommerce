# Copy to storefront/.env.local for local development. Never commit .env.local.
# Server-side only: no NEXT_PUBLIC_ prefix, because the browser never calls
# Medusa directly. See docs/local-infrastructure.md sections 6 and 7.
MEDUSA_BACKEND_URL=http://localhost:9000

# Created in Medusa Admin (Settings > Publishable API Keys) after the backend
# first runs. Placeholder until then.
MEDUSA_PUBLISHABLE_KEY=pk_replace_me
